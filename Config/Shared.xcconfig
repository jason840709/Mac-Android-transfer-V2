MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CLANG_C_LANGUAGE_STANDARD = c11
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = MTPBridge.entitlements
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Sources/MTPBridgeCLib/include $(SRCROOT)/Vendor/include
LIBRARY_SEARCH_PATHS = $(inherited) $(SRCROOT)/Vendor/lib
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
OTHER_LDFLAGS = $(inherited) -lmtp -lusb-1.0
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Sources/MTPBridgeApp/MTPBridge-Bridging-Header.h
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
PRODUCT_BUNDLE_IDENTIFIER = io.github.mtpbridge.MTPBridge
MARKETING_VERSION = 0.7.0
CURRENT_PROJECT_VERSION = 22

PRODUCT_NAME = Android 傳輸 V2
EXECUTABLE_NAME = MTPBridge
